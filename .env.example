# 온전(穩全) API 키 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 .gitignore 처리되어 커밋되지 않습니다.

# LLM (우선순위: Gemini → Anthropic. 둘 다 없으면 오프라인 MockLLM 데모 모드)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 모델 교체 (기본: gemini-2.5-flash / anthropic 사용 시 claude-sonnet-5)
ONJEON_MODEL=

# 국토부 실거래가 API — 공공데이터포털 data.go.kr 서비스키(마이페이지>일반인증키 Decoding).
# 아래 6개 데이터셋에 "활용신청"하면 같은 키로 전부 열림(빌라 매매는 기본 승인).
#   연립다세대 매매 https://www.data.go.kr/data/15126467/openapi.do
#   연립다세대 전월세 https://www.data.go.kr/data/15126473/openapi.do
#   아파트 매매 https://www.data.go.kr/data/15126469/openapi.do
#   아파트 전월세 https://www.data.go.kr/data/15126474/openapi.do
#   오피스텔 매매 https://www.data.go.kr/data/15126464/openapi.do
#   오피스텔 전월세 https://www.data.go.kr/data/15126475/openapi.do
MOLIT_API_KEY=

# RAG 임베딩 모델 (미설정 시 소형 MiniLM — Streamlit Cloud 메모리 제약 대응)
# 로컬 권장: 골든셋 Recall@5 1.000 / MRR 0.961 (2026-07-19 실측)
ONJEON_EMBED_MODEL=intfloat/multilingual-e5-large

# L2 리스크 모델 백엔드 (lr | xgb — 기본 lr, 실데이터 결합 시 xgb 권장)
ONJEON_L2_BACKEND=
