# 온전(穩全) API 키 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 .gitignore 처리되어 커밋되지 않습니다.

# LLM (우선순위: Gemini → Anthropic. 둘 다 없으면 오프라인 MockLLM 데모 모드)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 모델 교체 (기본: gemini-2.5-flash / anthropic 사용 시 claude-sonnet-5)
ONJEON_MODEL=

# 국토부 실거래가 API — 공공데이터포털 data.go.kr 서비스키.
#
# 발급: data.go.kr 회원가입 → 마이페이지 > 오픈API > 인증키 발급현황 >
#       "일반 인증키(Decoding)" 값을 복사해 아래에 붙여넣는다.
#       Encoding 값이 아니라 Decoding 값이다(Encoding을 넣으면 퍼센트 인코딩이 이중으로
#       걸려 인증 실패한다). 키는 계정당 1개이고 모든 데이터셋이 이 키를 공유한다.
#
# 활용신청: 아래 8개 데이터셋 각각의 페이지에서 "활용신청"을 눌러야 그 키로 열린다
#       (승인은 보통 즉시~2시간, 자동승인 항목이 많다). 신청 안 한 데이터셋만 403이 난다.
#   아파트     매매   https://www.data.go.kr/data/15126469/openapi.do
#   아파트     전월세 https://www.data.go.kr/data/15126474/openapi.do
#   연립다세대 매매   https://www.data.go.kr/data/15126467/openapi.do
#   연립다세대 전월세 https://www.data.go.kr/data/15126473/openapi.do
#   오피스텔   매매   https://www.data.go.kr/data/15126464/openapi.do
#   오피스텔   전월세 https://www.data.go.kr/data/15126475/openapi.do
#   단독/다가구 매매   https://www.data.go.kr/data/15126465/openapi.do
#   단독/다가구 전월세 https://www.data.go.kr/data/15126472/openapi.do
#
# 참고: 상세판(...TradeDev)은 별개 데이터셋이라 따로 신청해야 한다 — 코드는 기본판만 쓴다.
# 확인: .venv/bin/python scripts/warm_cache.py  (403이 나면 그 데이터셋 활용신청 누락)
MOLIT_API_KEY=

# 한국주택금융공사(HF) 전세자금대출 은행별 실측 금리 — 선택
#   https://www.data.go.kr/data/15082044/openapi.do  (무료·자동승인)
# MOLIT과 같은 공공데이터포털이지만 **데이터셋별로 활용신청이 따로**라 별도 키다.
# 없어도 앱은 돈다 — market_params의 대표값 3.5%로 계산한다(단, 그 값은 [확인] 상태다).
# 있으면: .venv/bin/python scripts/fetch_bank_rates.py 로 은행별 실측 금리를 받는다.
# ※ '인코딩 키'가 아니라 '디코딩 키'를 넣을 것 — 이중 인코딩되면 401이 난다.
#
# 은행 홈페이지를 긁지 않는 이유: obank.kbstar.com·portal.kfb.or.kr 모두
# robots.txt가 `User-agent: * / Disallow: /` 다. 공개 API만 쓴다.
HF_API_KEY=

# RAG 임베딩 모델 (미설정 시 소형 MiniLM — Streamlit Cloud 메모리 제약 대응)
# 로컬 권장: 골든셋 Recall@5 1.000 / MRR 0.961 (2026-07-19 실측)
ONJEON_EMBED_MODEL=intfloat/multilingual-e5-large

# L2 리스크 모델 백엔드 (lr | xgb — 기본 lr, 실데이터 결합 시 xgb 권장)
ONJEON_L2_BACKEND=

# ngrok 고정 도메인 — ./tunnel.sh 가 공개할 주소. 이 값이 있어야 재시작해도 URL이 같다.
# 발급: https://dashboard.ngrok.com 가입(무료·카드 불필요) → Domains 메뉴에 자동 배정된 값.
#       인증은 별도 1회: ngrok config add-authtoken <Getting Started의 토큰>
# 예: abc123xyz.ngrok-free.dev  (https:// 없이 도메인만)
ONJEON_NGROK_DOMAIN=
